# Copia questo file in ".env" e riempi i valori veri.
# Il file .env NON va mai su GitHub (è gia' ignorato da git).

# --- LLM: Kimi K2.5 di Moonshot (API compatibile-OpenAI) ---
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
AI_MODEL=kimi-k2.5

# --- Voce: ElevenLabs ---
ELEVENLABS_API_KEY=

# --- Generale ---
# Origini permesse a chiamare l'API (l'app mobile). * = tutte, comodo in sviluppo.
ALLOWED_ORIGINS=*
